{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "box2d-scenarios",
  "main": "src/index.ts",
  "compatibility_date": "2026-08-17",
  "observability": {
    "enabled": true,
    "head_sampling_rate": 0.1
  },
  "assets": {
    // Static files take the fast asset path; only the scenario API invokes
    // the Worker and D1. The directory is prepared by web/prepare.py.
    "directory": "../web",
    "run_worker_first": ["/s", "/s/*"]
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "box2d-scenarios",
      // Filled in by `wrangler d1 create box2d-scenarios`, which prints it.
      // Deploying without it fails rather than writing somewhere unexpected.
      "database_id": "REPLACE_WITH_DATABASE_ID",
      "migrations_dir": "migrations"
    }
  ]
}
