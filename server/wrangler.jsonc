{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "box2d-py",
  "main": "src/index.ts",
  "compatibility_date": "2026-08-17",
  "observability": {
    "enabled": true,
    "head_sampling_rate": 0.1
  },
  "assets": {
    // Static files take the fast asset path; only the scenario API invokes
    // the Worker and D1. The directory is prepared by web/prepare.py.
    "directory": "../web",
    "run_worker_first": ["/s", "/s/*"]
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "box2d-py",
      "database_id": "d7841d7a-0977-4404-a9b7-af09acf450f4",
      "migrations_dir": "migrations"
    }
  ]
}
