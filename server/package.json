{
  "name": "box2d-scenarios",
  "private": true,
  "type": "module",
  "description": "Content-addressed store for box2d-py testbed scenarios",
  "engines": {
    "node": ">=22.0.0"
  },
  "scripts": {
    "prepare:web": "python3 ../web/prepare.py",
    "dev": "npm run prepare:web && wrangler dev",
    "test": "vitest run",
    "typecheck": "wrangler types && tsc --noEmit",
    "migrate:local": "wrangler d1 migrations apply box2d-scenarios --local",
    "migrate:remote": "wrangler d1 migrations apply box2d-scenarios --remote",
    "deploy": "npm run prepare:web && wrangler deploy"
  },
  "devDependencies": {
    "@cloudflare/vitest-pool-workers": "^0.21.3",
    "@types/node": "^26.2.0",
    "typescript": "^5.7.0",
    "vitest": "~4.1.0",
    "wrangler": "^4.123.0"
  }
}
