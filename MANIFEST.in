recursive-include box2d *

# The submodule is swept in wholesale. Builds now keep their CMake trees in
# build/cmake, but a checkout that built before that may still have one in
# box2d/build -- object files and a CMakeCache.txt full of local absolute
# paths -- so it stays excluded.
prune box2d/build

# setup.py builds the extension from this, and src/tools is not a package.
include src/tools/build_cffi.py

include LICENSE
include LICENSE-Box2D
include README.md
